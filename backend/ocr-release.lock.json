  "payload_assembly": {
    "schema_version": 2,
    "offline_only": true,
    "inputs": [
      {
        "artifact": "paddleocr_runner",
        "component": "runner",
        "source": "runner/paddle_ocr_runner.exe",
        "destination": "paddle/bin/paddle_ocr_runner.exe",
        "kind": "file"
      },
      {
        "artifact": "paddlepaddle_windows_x64_cp312",
        "component": "runtime",
        "source": "runtime/paddlepaddle-3.2.0-cp312-cp312-win_amd64.whl",
        "destination": "paddle/runtime",
        "kind": "wheel"
      },
      {
        "artifact": "ppocrv5_det_config_json",
        "component": "models",
        "source": "models/det/config.json",
        "destination": "paddle/models/det/config.json",
        "kind": "file"
      },
      {
        "artifact": "ppocrv5_det_inference_json",
        "component": "models",
        "source": "models/det/inference.json",
        "destination": "paddle/models/det/inference.json",
        "kind": "file"
      },
      {
        "artifact": "ppocrv5_det_parameters",
        "component": "models",
        "source": "models/det/inference.pdiparams",
        "destination": "paddle/models/det/inference.pdiparams",
        "kind": "file"
      },
      {
        "artifact": "ppocrv5_det_inference_yml",
        "component": "models",
        "source": "models/det/inference.yml",
        "destination": "paddle/models/det/inference.yml",
        "kind": "file"
      },
      {
        "artifact": "latin_ppocrv5_rec_config_json",
        "component": "models",
        "source": "models/rec/config.json",
        "destination": "paddle/models/rec/config.json",
        "kind": "file"
      },
      {
        "artifact": "latin_ppocrv5_rec_inference_json",
        "component": "models",
        "source": "models/rec/inference.json",
        "destination": "paddle/models/rec/inference.json",
        "kind": "file"
      },
      {
        "artifact": "latin_ppocrv5_rec_parameters",
        "component": "models",
        "source": "models/rec/inference.pdiparams",
        "destination": "paddle/models/rec/inference.pdiparams",
        "kind": "file"
      },
      {
        "artifact": "latin_ppocrv5_rec_inference_yml",
        "component": "models",
